# The Elexon BMRS Insights API is public: these datasets need no API key, and
# the application ships no credentials. Everything below is optional tuning.
#
# Copy to .env to override. Never commit a real .env.

# --- Backend (prefix APP_) ---
# APP_ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
# APP_ELEXON_TIMEOUT_SECONDS=30
# APP_ELEXON_MAX_RETRIES=3

# Analysis defaults. The agreed analysis scope is January 2026 decisions.
# APP_DEFAULT_DECISION_FROM=2026-01-01
# APP_DEFAULT_DECISION_TO=2026-01-31
# APP_DEFAULT_CUTOFF_TIME=09:00
# APP_DEFAULT_CUTOFF_DAYS_BEFORE=1
# APP_DEFAULT_MAPE_FLOOR_MW=100

# APP_CACHE_TTL_SECONDS=900
# APP_LOG_LEVEL=INFO

# --- Frontend (build-time, prefix VITE_) ---
# Leave unset. The app calls a relative /api path, which Vite proxies in
# development, nginx proxies in Docker, and Vercel rewrites in production.
# Only set this when the API is deployed to a different origin.
# VITE_API_BASE_URL=

# Where `npm run dev` proxies /api to.
# VITE_DEV_API_TARGET=http://localhost:8000
